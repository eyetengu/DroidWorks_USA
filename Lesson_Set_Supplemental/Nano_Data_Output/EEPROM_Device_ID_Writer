#include <EEPROM.h>

const char DEVICE_ID[] = "M001";

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Programming EEPROM...");

  int address = 0;

  for (unsigned int i = 0; i < sizeof(DEVICE_ID); i++) {
    EEPROM.update(address + i, DEVICE_ID[i]);
  }

  Serial.print("Stored ID: ");
  Serial.println(DEVICE_ID);

  Serial.println("Done.");
}

void loop() {
}
