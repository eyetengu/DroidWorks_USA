/*
  Open Droid Lab — Nano Identity / Diagnostic Sketch

  Purpose:
    Print identifying information that the Arduino itself
    can provide.

  This is an experiment, not a sensor application.
*/

void setup() {
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("Open Droid Lab - Nano Identity");
  Serial.println("================================");

  Serial.println();
  Serial.println("[DEVICE]");
  Serial.println("Device: Arduino Nano");

  Serial.println();
  Serial.println("[MCU]");
  Serial.print("Architecture: ");
  Serial.println(F_CPU);

  Serial.print("CPU Frequency: ");
  Serial.print(F_CPU / 1000000);
  Serial.println(" MHz");

  Serial.println();
  Serial.println("[MEMORY]");

  Serial.print("Free SRAM: ");
  Serial.print(freeMemory());
  Serial.println(" bytes");

  Serial.println();
  Serial.println("[ARDUINO]");

  Serial.print("Analog pins: ");
  Serial.println(NUM_ANALOG_INPUTS);

  Serial.print("Digital pins: ");
  Serial.println(NUM_DIGITAL_PINS);

  Serial.println();
  Serial.println("[TIMING]");

  Serial.print("millis(): ");
  Serial.println(millis());

  Serial.println();
  Serial.println("[END]");
  Serial.println();
}

void loop() {
  // Nothing else to do.
}


// --------------------------------------------------
// Estimate remaining SRAM
// --------------------------------------------------

extern unsigned int __heap_start;
extern void *__brkval;

int freeMemory() {
  int free_memory;

  if ((int)__brkval == 0) {
    free_memory = ((int)&free_memory) - ((int)&__heap_start);
  } else {
    free_memory = ((int)&free_memory) - ((int)__brkval);
  }

  return free_memory;
}
