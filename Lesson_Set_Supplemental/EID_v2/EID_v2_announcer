/*
  Droid Works USA
  EEPROM Device Information Announcer

  Reads the stored device information and repeatedly
  announces it over Serial.

  EID
  TYPE
  SENSOR
  SENSOR2
*/

#include <EEPROM.h>

const int EID_ADDR    = 0;
const int TYPE_ADDR   = 32;
const int SENSOR_ADDR = 64;
const int SENSOR2_ADDR = 96;

String readString(int address) {
  String result = "";

  for (int i = 0; i < 32; i++) {
    char character = EEPROM.read(address + i);

    if (character == '\0') {
      break;
    }

    result += character;
  }

  return result;
}

void setup() {
  Serial.begin(115200);
  delay(1000);
}

void loop() {
  String eid = readString(EID_ADDR);
  String type = readString(TYPE_ADDR);
  String sensor = readString(SENSOR_ADDR);
  String sensor2 = readString(SENSOR2_ADDR);

  Serial.print("EID:");
  Serial.print(eid);

  Serial.print(",TYPE:");
  Serial.print(type);

  Serial.print(",SENSOR:");
  Serial.print(sensor);

  Serial.print(",SENSOR2:");
  Serial.println(sensor2);

  delay(2000);
}
