/*
  Droid Works USA
  EEPROM Device Information Reader

  Reads:
    EID
    TYPE
    SENSOR
    SENSOR2
*/

#include <EEPROM.h>

const int EID_ADDR    = 0;
const int TYPE_ADDR   = 32;
const int SENSOR_ADDR = 64;
const int SENSOR2_ADDR = 96;

String readString(int address) {
  String result = "";

  char character;
  int i = 0;

  while (i < 32) {
    character = EEPROM.read(address + i);

    if (character == '\0') {
      break;
    }

    result += character;
    i++;
  }

  return result;
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  String eid = readString(EID_ADDR);
  String type = readString(TYPE_ADDR);
  String sensor = readString(SENSOR_ADDR);
  String sensor2 = readString(SENSOR2_ADDR);

  Serial.println("Droid Works USA Device Information");
  Serial.println("----------------------------------");

  Serial.print("EID: ");
  Serial.println(eid);

  Serial.print("TYPE: ");
  Serial.println(type);

  Serial.print("SENSOR: ");
  Serial.println(sensor);

  Serial.print("SENSOR2: ");
  Serial.println(sensor2);
}

void loop() {
  // Nothing to do
}
