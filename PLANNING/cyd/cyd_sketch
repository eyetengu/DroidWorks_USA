void drawCurrentPageFull() {
  tft.fillScreen(TFT_BLACK);
  switch (currentPage) {
    case PAGE_OVERVIEW:    drawOverview();    break;
    case PAGE_AFFECT:      drawAffect();      break;
    case PAGE_MOTION:      drawMotion();      break;
    case PAGE_ORIENTATION: drawOrientation(); break;
    case PAGE_SYSTEM:      drawSystem();      break;
  }
  drawPageDots();
  fullDirty = false;
  dataDirty = false;
  lastFullRedrawMs = millis();
  lastVolatileRedrawMs = millis();
}

void drawCurrentPageVolatile() {
  switch (currentPage) {
    case PAGE_OVERVIEW:    drawOverviewVolatile();    break;
    case PAGE_AFFECT:      drawAffectVolatile();      break;
    case PAGE_MOTION:      drawMotionVolatile();      break;
    case PAGE_ORIENTATION: drawOrientationVolatile(); break;
    case PAGE_SYSTEM:      drawSystemVolatile();      break;
  }
  dataDirty = false;
  lastVolatileRedrawMs = millis();
}

// -------------------- Navigation --------------------
void nextPage() { currentPage = (currentPage + 1) % PAGE_COUNT; fullDirty = true; }
void prevPage() { currentPage = (currentPage == 0) ? PAGE_COUNT - 1 : currentPage - 1; fullDirty = true; }
void goHome()   { currentPage = PAGE_OVERVIEW; fullDirty = true; }

// -------------------- Setup --------------------
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\nDroidWorks CYD Debug Surface v0.3");

  tft.init();
  tft.setRotation(DISPLAY_ROTATION);
  tft.fillScreen(TFT_BLACK);

  touchSPI.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin(touchSPI);
  ts.setRotation(DISPLAY_ROTATION-2);

  // Boot splash
  int logoX = (320 - DW_LOGO_W) / 2;
  int logoY = (240 - DW_LOGO_H) / 2 - 10;
  tft.pushImage(logoX, logoY, DW_LOGO_W, DW_LOGO_H, dw_logo);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_SILVER, TFT_BLACK);
  tft.drawString("Debug Surface v0.3", 160, logoY + DW_LOGO_H + 16, 2);
  tft.drawString("connecting...", 160, logoY + DW_LOGO_H + 36, 1);

  // WiFi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("WiFi");
  uint32_t wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - wifiStart < 15000) {
    delay(400);
    Serial.print(".");
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("IP ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("WiFi failed - will keep retrying");
  }

  // MQTT
  mqtt.setServer(MQTT_HOST, MQTT_PORT);
  mqtt.setCallback(mqttCallback);
  mqtt.setBufferSize(512);
  mqttReconnect();

  fullDirty = true;
}

// -------------------- Loop --------------------
void loop() {
  ensureNetwork();
  mqtt.loop();

  // Mark link down if packets stop
  if (data.linkUp && (millis() - data.lastPacketMs > LINK_DEAD_MS)) {
    data.linkUp = false;
    dataDirty = true;
  }

  // LIVE → STALE transition without waiting for a value change
  static bool wasStale = false;
  bool isStale = data.linkUp && (millis() - data.lastPacketMs > LINK_STALE_MS);
  if (isStale != wasStale) {
    wasStale = isStale;
    dataDirty = true;
  }

  // Periodic full refresh (recovers any partial-draw glitches, rare)
  if (millis() - lastFullRedrawMs >= FULL_REFRESH_MS) {
    fullDirty = true;
  }

  // --- Touch navigation ---
  int16_t tx, ty;
  bool down = readTouch(tx, ty);

  if (down && !touchWasDown) {
    touchDownMs  = millis();
    touchStartX  = tx;
    touchWasDown = true;
  } else if (!down && touchWasDown) {
    uint32_t held = millis() - touchDownMs;
    if (millis() - lastTouchNavMs > TOUCH_DEBOUNCE_MS) {
      if (held > 900) {
        goHome();
        lastTouchNavMs = millis();
      } else if (held < 500) {
        if (touchStartX < 106) {
#if DISPLAY_ROTATION == 3
          nextPage();
#else
          prevPage();
#endif
          lastTouchNavMs = millis();
        } else if (touchStartX > 214) {
#if DISPLAY_ROTATION == 3
          prevPage();
#else
          nextPage();
#endif
          lastTouchNavMs = millis();
        }
      }
    }
    touchWasDown = false;
  }

  // Draw: full takes priority; otherwise throttled volatile update
  if (fullDirty) {
    drawCurrentPageFull();
  } else if (dataDirty && (millis() - lastVolatileRedrawMs >= VOLATILE_REFRESH_MS)) {
    drawCurrentPageVolatile();
  }

  delay(20);
}
