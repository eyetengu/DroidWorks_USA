/*******************************************************************
  DroidWorks USA - CYD Forearm Debug Surface  v0.3
  ESP32-2432S028 (Cheap Yellow Display)

  Multi-page operator display driven by MQTT status feed from
  the ROS debug exit node (droidworks/debug/status).

  Refresh model:
    Full page redraw  every FULL_REFRESH_MS (or on page change)
    Volatile fields   every VOLATILE_REFRESH_MS when data changed
    Stops the whole-screen blink from 4 Hz MQTT updates.

  Pages:
    0  Overview      - logo, affect, vigilance, last events, data age
    1  Affect Detail - state machine detail
    2  Motion        - PIR / RCWL / fused presence
    3  Orientation   - tilt / shock (placeholders until DW_005)
    4  System        - health, uptime, packet stats

  Touch (rotation 3 = left forearm):
    tap left 1/3  = next page
    tap right 1/3 = previous page
    hold ~1s      = jump to Overview

  Requires libraries (Library Manager):
    - TFT_eSPI          (with CYD User_Setup.h)
    - XPT2046_Touchscreen
    - PubSubClient
    - ArduinoJson

  Also needs: dw_logo.h in the same folder

  Board: ESP32 Dev Module
 *******************************************************************/

#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <TFT_eSPI.h>
#include <XPT2046_Touchscreen.h>
#include <math.h>
#include "dw_logo.h"

// ===================== USER CONFIG =====================
const char* WIFI_SSID     = "badap";
const char* WIFI_PASSWORD = "EricLAN01!";

// Pi running Mosquitto + dw_debug_exit_node (LAN IP)
const char* MQTT_HOST     = "192.168.1.107";   // <-- set to your Pi IP
const uint16_t MQTT_PORT  = 1883;
const char* MQTT_TOPIC    = "droidworks/debug/status";
const char* MQTT_CLIENT_ID = "cyd_debug_surface";

// 1 = original landscape, 3 = left-forearm readable
#define DISPLAY_ROTATION 3

// How long without a packet before we show STALE / NO LINK
#define LINK_STALE_MS  3000
#define LINK_DEAD_MS   8000

// Staged refresh (ms)  --- tune these if needed ---
// Full = logo/header/labels (expensive, causes blink if too often)
// Volatile = numbers/bars only, and ONLY when values actually change
#define FULL_REFRESH_MS      30000   // full page redraw interval (30 s)
#define VOLATILE_REFRESH_MS    500   // min gap between data-only redraws
// =======================================================

// -------------------- Touch (CYD XPT2046) --------------------
#define XPT2046_IRQ  36
#define XPT2046_MOSI 32
#define XPT2046_MISO 39
#define XPT2046_CLK  25
#define XPT2046_CS   33

SPIClass touchSPI = SPIClass(VSPI);
XPT2046_Touchscreen ts(XPT2046_CS, XPT2046_IRQ);

// -------------------- Display / network --------------------
TFT_eSPI tft = TFT_eSPI();
WiFiClient wifiClient;
PubSubClient mqtt(wifiClient);

// -------------------- Pages --------------------
enum Page : uint8_t {
  PAGE_OVERVIEW = 0,
  PAGE_AFFECT,
  PAGE_MOTION,
  PAGE_ORIENTATION,
  PAGE_SYSTEM,
  PAGE_COUNT
};

const char* PAGE_NAMES[PAGE_COUNT] = {
  "Overview",
  "Affect",
  "Motion",
  "Orientation",
  "System"
};

uint8_t currentPage = PAGE_OVERVIEW;
bool    fullDirty   = true;   // full fillScreen + chrome
bool    dataDirty   = false;  // volatile fields only

uint32_t lastFullRedrawMs     = 0;
uint32_t lastVolatileRedrawMs = 0;

// -------------------- Live data --------------------
struct DebugData {
  char     affectState[16] = "CALM";
  uint8_t  level           = 0;
  uint8_t  vigilancePct    = 0;
  uint16_t alertTimerSec   = 0;
  uint16_t focusedTimerSec = 0;

  bool pirActive   = false;
  bool rcwlActive  = false;
  bool fusedMotion = false;

  bool  shockLatched = false;
  bool  tiltActive   = false;
  float tiltX        = 0.0f;
  float tiltY        = 0.0f;

  char     oledExpr[24] = "";
  uint32_t lastPacketMs = 0;
  uint32_t packetCount  = 0;
  bool     linkUp       = false;
} data;

// -------------------- Touch helpers --------------------
uint32_t touchDownMs    = 0;
bool     touchWasDown   = false;
int16_t  touchStartX    = 0;
#define TOUCH_DEBOUNCE_MS  180
uint32_t lastTouchNavMs = 0;

#define TOUCH_X_MIN 200
#define TOUCH_X_MAX 3700
#define TOUCH_Y_MIN 240
#define TOUCH_Y_MAX 3800

bool readTouch(int16_t &x, int16_t &y) {
  if (!ts.touched()) return false;
  TS_Point p = ts.getPoint();
  x = map(p.x, TOUCH_X_MIN, TOUCH_X_MAX, 0, 320);
  y = map(p.y, TOUCH_Y_MIN, TOUCH_Y_MAX, 0, 240);
  x = constrain(x, 0, 319);
  y = constrain(y, 0, 239);
  return true;
}

// -------------------- MQTT --------------------
void applyStatusJson(const char* json) {
  // Payload is small; 512 is plenty
  StaticJsonDocument<512> doc;
  DeserializationError err = deserializeJson(doc, json);
  if (err) {
    Serial.print("JSON error: ");
    Serial.println(err.c_str());
    return;
  }

  // Parse into locals first, then compare — only dirty UI if something changed
  char newAffect[16];
  const char* aff = doc["affect"] | "CALM";
  strncpy(newAffect, aff, sizeof(newAffect) - 1);
  newAffect[sizeof(newAffect) - 1] = '\0';

  uint8_t newLevel = (uint8_t)(doc["level"] | 0);
  uint8_t newVig   = (uint8_t)constrain((int)(doc["vigilance"] | 0), 0, 100);
  bool newPir      = doc["pir"]   | false;
  bool newRcwl     = doc["rcwl"]  | false;
  bool newFused    = doc["fused"] | false;
  bool newShock    = doc["shock"] | false;
  bool newTilt     = doc["tilt"]  | false;
  float newTiltX   = doc["tilt_x"] | 0.0f;
  float newTiltY   = doc["tilt_y"] | 0.0f;

  char newExpr[24];
  const char* expr = doc["oled_expr"] | "";
  strncpy(newExpr, expr, sizeof(newExpr) - 1);
  newExpr[sizeof(newExpr) - 1] = '\0';

  bool changed =
      (strcmp(newAffect, data.affectState) != 0) ||
      (newLevel != data.level) ||
      (newVig   != data.vigilancePct) ||
      (newPir   != data.pirActive) ||
      (newRcwl  != data.rcwlActive) ||
      (newFused != data.fusedMotion) ||
      (newShock != data.shockLatched) ||
      (newTilt  != data.tiltActive) ||
      (fabsf(newTiltX - data.tiltX) > 0.05f) ||
      (fabsf(newTiltY - data.tiltY) > 0.05f) ||
      (strcmp(newExpr, data.oledExpr) != 0) ||
      (!data.linkUp);

  strncpy(data.affectState, newAffect, sizeof(data.affectState));
  data.level        = newLevel;
  data.vigilancePct = newVig;
  data.pirActive    = newPir;
  data.rcwlActive   = newRcwl;
  data.fusedMotion  = newFused;
  data.shockLatched = newShock;
  data.tiltActive   = newTilt;
  data.tiltX        = newTiltX;
  data.tiltY        = newTiltY;
  strncpy(data.oledExpr, newExpr, sizeof(data.oledExpr));

  data.lastPacketMs = millis();
  data.packetCount++;
  data.linkUp = true;

  // Only request a volatile redraw when values actually changed
  if (changed) {
    dataDirty = true;
  }
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  // Copy into a null-terminated buffer
  char buf[512];
  if (length >= sizeof(buf)) length = sizeof(buf) - 1;
  memcpy(buf, payload, length);
  buf[length] = '\0';

  // Quiet by default — uncomment for debugging payloads
  // Serial.print("MQTT ["); Serial.print(topic); Serial.print("] "); Serial.println(buf);

  applyStatusJson(buf);
}

bool mqttReconnect() {
  if (mqtt.connected()) return true;

  Serial.print("MQTT connect...");
  if (mqtt.connect(MQTT_CLIENT_ID)) {
    Serial.println("ok");
    mqtt.subscribe(MQTT_TOPIC);
    return true;
  }
  Serial.print("fail rc=");
  Serial.println(mqtt.state());
  return false;
}

void ensureNetwork() {
  if (WiFi.status() != WL_CONNECTED) {
    if (data.linkUp) {
      data.linkUp = false;
      dataDirty = true;
    }
    static uint32_t lastAttempt = 0;
    if (millis() - lastAttempt < 5000) return;
    lastAttempt = millis();
    Serial.println("WiFi reconnect...");
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    return;
  }

  if (!mqtt.connected()) {
    static uint32_t lastMqttTry = 0;
    if (millis() - lastMqttTry < 3000) return;
    lastMqttTry = millis();
    mqttReconnect();
  }
}

// -------------------- Drawing --------------------
void drawHeader(const char* title) {
  tft.fillRect(0, 0, 320, 22, TFT_NAVY);
  tft.setTextColor(TFT_WHITE, TFT_NAVY);
  tft.setTextDatum(TL_DATUM);
  tft.drawString("DW Debug", 6, 4, 2);
  tft.setTextDatum(TR_DATUM);
  tft.drawString(title, 314, 4, 2);
}

void drawPageDots() {
  const int baseX = 160 - ((PAGE_COUNT - 1) * 10);
  const int y = 228;
  for (uint8_t i = 0; i < PAGE_COUNT; i++) {
    uint16_t color = (i == currentPage) ? TFT_CYAN : TFT_DARKGREY;
    tft.fillCircle(baseX + i * 20, y, 4, color);
  }
}

void drawDataAge() {
  // Clear previous label then redraw (volatile region)
  tft.fillRect(250, 24, 70, 12, TFT_BLACK);
  uint32_t age = millis() - data.lastPacketMs;
  tft.setTextDatum(TR_DATUM);
  if (!data.linkUp || age > LINK_DEAD_MS) {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.drawString("NO LINK", 314, 26, 1);
  } else if (age > LINK_STALE_MS) {
    tft.setTextColor(TFT_ORANGE, TFT_BLACK);
    tft.drawString("STALE", 314, 26, 1);
  } else {
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.drawString("LIVE", 314, 26, 1);
  }
}

uint16_t affectColor(const char* state) {
  if (strcasecmp(state, "CALM")    == 0) return TFT_CYAN;
  if (strcasecmp(state, "ALERT")   == 0) return TFT_YELLOW;
  if (strcasecmp(state, "FOCUSED") == 0) return TFT_GREEN;
  if (strcasecmp(state, "WARY")    == 0) return TFT_ORANGE;
  if (strcasecmp(state, "GUARDED") == 0) return TFT_RED;
  return TFT_WHITE;
}

