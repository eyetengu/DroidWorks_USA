  tft.setTextColor(TFT_SILVER, TFT_BLACK);
  char buf[48];
  snprintf(buf, sizeof(buf), "Shock:%s  Tilt:%s  Motion:%s",
           data.shockLatched ? "YES" : "no",
           data.tiltActive   ? "YES" : "no",
           data.fusedMotion  ? "YES" : "no");
  tft.drawString(buf, 12, 200, 1);
