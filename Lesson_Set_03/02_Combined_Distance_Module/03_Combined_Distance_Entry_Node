#!/usr/bin/env python3
"""
DroidWorks U.S.A. — Combined Distance Entry Node
Serial reader for the dual-distance Nano sketch

MCU side:
  DW_004_Combined_Distance_Nano_millis_SERIAL.ino
  115200 baud
  Line format:  US:123 TOF:456 FUSED:123   (millimeters, -1 = invalid)

Publishes:
  /ultrasonic_mm   (std_msgs/Int16)
  /tof_mm          (std_msgs/Int16)
  /fused_distance  (std_msgs/Int16)
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Int16

import serial
import serial.tools.list_ports


SERIAL_PORT = '/dev/ttyUSB0'   # change to /dev/ttyACM0 if needed
BAUD_RATE   = 115200


class DWDistanceEntryNode(Node):
    def __init__(self):
        super().__init__('dw_distance_entry_node')

        self.pub_us    = self.create_publisher(Int16, '/ultrasonic_mm', 10)
        self.pub_tof   = self.create_publisher(Int16, '/tof_mm', 10)
        self.pub_fused = self.create_publisher(Int16, '/fused_distance', 10)

        self.ser = None
        self._open_serial()

        self.create_timer(0.05, self._serial_timer_callback)

        self.get_logger().info('DroidWorks distance entry node ready')
        self.get_logger().info('Publishing: /ultrasonic_mm  /tof_mm  /fused_distance')

    def _open_serial(self):
        try:
            self.ser = serial.Serial(
                port=SERIAL_PORT,
                baudrate=BAUD_RATE,
                timeout=0.01,
                write_timeout=0.5
            )
            self.get_logger().info(f'Serial opened: {SERIAL_PORT} @ {BAUD_RATE}')
        except serial.SerialException as e:
            self.get_logger().error(f'Could not open {SERIAL_PORT}: {e}')
            self.get_logger().info('Available ports:')
            for p in serial.tools.list_ports.comports():
                self.get_logger().info(f'  {p.device} — {p.description}')
            self.ser = None

    def _serial_timer_callback(self):
        if self.ser is None or not self.ser.is_open:
            return

        try:
            while self.ser.in_waiting > 0:
                raw = self.ser.readline()
                if not raw:
                    break
                line = raw.decode('utf-8', errors='ignore').strip()
                if not line:
                    continue
                self._handle_line(line)
        except serial.SerialException as e:
            self.get_logger().error(f'Serial read error: {e}')
            self.ser = None

    def _handle_line(self, line: str):
        if not line.startswith('US:'):
            self.get_logger().debug(f'MCU: {line}')
            return

        try:
            parts = line.split()
            if len(parts) != 3:
                self.get_logger().warn(f'Unexpected token count: {line!r}')
                return

            us_val    = int(parts[0].split(':', 1)[1])
            tof_val   = int(parts[1].split(':', 1)[1])
            fused_val = int(parts[2].split(':', 1)[1])

            msg_us = Int16()
            msg_us.data = us_val
            self.pub_us.publish(msg_us)

            msg_tof = Int16()
            msg_tof.data = tof_val
            self.pub_tof.publish(msg_tof)

            msg_fused = Int16()
            msg_fused.data = fused_val
            self.pub_fused.publish(msg_fused)

            self.get_logger().info(
                f'Published  us={us_val}  tof={tof_val}  fused={fused_val}  (mm)'
            )

        except (ValueError, IndexError) as e:
            self.get_logger().warn(f'Bad data line: {line!r}  ({e})')


def main(args=None):
    rclpy.init(args=args)
    node = DWDistanceEntryNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node.ser is not None and node.ser.is_open:
            node.ser.close()
            node.get_logger().info('Serial closed')
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
