#!/usr/bin/env python3
"""
DroidWorks U.S.A. — Combined Motion Entry Node
Discovers the Nano by EEPROM identity, then publishes:
  /pir_state
  /rcwl_state
  /fused_motion

MCU side:
  DW_003_PIR_RCWL_Nano_millis_SERIAL.ino
  Startup:  EID:...,TYPE:MOTION,SENSOR:PIR,SENSOR2:RCWL
  Data:     PIR:0 RCWL:1 FUSED:0
"""

import time
import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool

import serial
import serial.tools.list_ports

# Common CH340 / Nano USB identifiers
VID = 6790
PID = 29987
BAUD_RATE = 115200
DISCOVERY_TIMEOUT = 3.0   # seconds to wait for announcement on a candidate


class DWSerialEntryNode(Node):
    """Discovers the motion board by EID and publishes PIR / RCWL / fused."""

    def __init__(self):
        super().__init__('dw_serial_entry_node')

        self.pub_pir   = self.create_publisher(Bool, '/pir_state', 10)
        self.pub_rcwl  = self.create_publisher(Bool, '/rcwl_state', 10)
        self.pub_fused = self.create_publisher(Bool, '/fused_motion', 10)

        self.ser = None
        self.eid = None

        self._discover_motion_board()

        self.create_timer(0.05, self._serial_timer_callback)

        self.get_logger().info('DroidWorks motion entry node ready')
        self.get_logger().info('Publishing: /pir_state  /rcwl_state  /fused_motion')

    def _discover_motion_board(self):
        """Scan USB ports, look for TYPE=MOTION + SENSOR=PIR."""
        self.get_logger().info('Searching for motion board...')

        ports = serial.tools.list_ports.comports()

        for port in ports:
            if port.vid != VID or port.pid != PID:
                continue

            self.get_logger().info(f'Checking candidate: {port.device}')

            try:
                ser = serial.Serial(
                    port.device,
                    BAUD_RATE,
                    timeout=0.5
                )

                start = time.time()
                while time.time() - start < DISCOVERY_TIMEOUT:
                    raw = ser.readline()
                    if not raw:
                        continue

                    line = raw.decode('utf-8', errors='ignore').strip()
                    if not line.startswith('EID:'):
                        continue

                    self.get_logger().info(f'Device announcement: {line}')

                    # Parse key:value pairs
                    fields = {}
                    for part in line.split(','):
                        if ':' in part:
                            k, v = part.split(':', 1)
                            fields[k] = v

                    eid     = fields.get('EID', '')
                    dtype   = fields.get('TYPE', '')
                    sensor  = fields.get('SENSOR', '')
                    sensor2 = fields.get('SENSOR2', '')

                    if dtype == 'MOTION' and sensor == 'PIR':
                        self.ser = ser
                        self.eid = eid
                        self.get_logger().info(
                            f'MOTION BOARD FOUND | EID={eid} | '
                            f'SENSOR={sensor}/{sensor2} | PORT={port.device}'
                        )
                        return

                ser.close()

            except serial.SerialException as e:
                self.get_logger().warn(f'Could not open {port.device}: {e}')

        self.get_logger().error('No matching motion board found.')
        self.ser = None

    def _serial_timer_callback(self):
        if self.ser is None or not self.ser.is_open:
            return

        try:
            while self.ser.in_waiting > 0:
                raw = self.ser.readline()
                if not raw:
                    break
                line = raw.decode('utf-8', errors='ignore').strip()
                if line:
                    self._handle_line(line)
        except serial.SerialException as e:
            self.get_logger().error(f'Serial read error: {e}')
            self.ser = None

    def _handle_line(self, line: str):
        if not line.startswith('PIR:'):
            self.get_logger().debug(f'MCU: {line}')
            return

        try:
            parts = line.split()
            if len(parts) != 3:
                self.get_logger().warn(f'Unexpected token count: {line!r}')
                return

            pir_val   = int(parts[0].split(':', 1)[1])
            rcwl_val  = int(parts[1].split(':', 1)[1])
            fused_val = int(parts[2].split(':', 1)[1])

            msg = Bool()
            msg.data = bool(pir_val)
            self.pub_pir.publish(msg)

            msg.data = bool(rcwl_val)
            self.pub_rcwl.publish(msg)

            msg.data = bool(fused_val)
            self.pub_fused.publish(msg)

            eid_str = self.eid if self.eid else '----'
            self.get_logger().info(
                f'[{eid_str}] pir={pir_val}  rcwl={rcwl_val}  fused={fused_val}'
            )

        except (ValueError, IndexError) as e:
            self.get_logger().warn(f'Bad data line: {line!r}  ({e})')


def main(args=None):
    rclpy.init(args=args)
    node = DWSerialEntryNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node.ser is not None and node.ser.is_open:
            node.ser.close()
            node.get_logger().info('Serial closed')
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
