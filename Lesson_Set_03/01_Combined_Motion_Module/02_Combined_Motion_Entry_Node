#!/usr/bin/env python3
"""
DroidWorks U.S.A. — Lesson Set 03 Entry Node
Serial reader for the dual-sensor Nano sketch

MCU side:
  DW_003_PIR_RCWL_Nano_millis_SERIAL.ino
  115200 baud
  Line format:  PIR:0 RCWL:1 FUSED:0

This node:
  - Opens the serial port from the Nano
  - Parses the three tokens
  - Publishes:
      /pir_state     (std_msgs/Bool)
      /rcwl_state    (std_msgs/Bool)
      /fused_motion  (std_msgs/Bool)

Dependencies (once in the ROS 2 environment):
  pip install pyserial
  (or declare in package.xml / setup.py later)
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool

import serial
import serial.tools.list_ports


# ====================== SERIAL CONFIG (edit for your machine) ======================
SERIAL_PORT = '/dev/ttyUSB0'   # Linux common; try /dev/ttyACM0 if needed
BAUD_RATE   = 115200
# ==================================================================================


class DWSerialEntryNode(Node):
    """DroidWorks Lesson Set 03 — serial entry node for PIR + RCWL + fused."""

    def __init__(self):
        super().__init__('dw_serial_entry_node')

        # --- Publishers (one per preferred topic) ---
        self.pub_pir    = self.create_publisher(Bool, '/pir_state', 10)
        self.pub_rcwl   = self.create_publisher(Bool, '/rcwl_state', 10)
        self.pub_fused  = self.create_publisher(Bool, '/fused_motion', 10)

        # --- Serial open ---
        self.ser = None
        self._open_serial()

        # Poll serial at ~20 Hz — plenty for motion edges
        self.create_timer(0.05, self._serial_timer_callback)

        self.get_logger().info('DroidWorks serial entry node ready')
        self.get_logger().info('Publishing: /pir_state  /rcwl_state  /fused_motion')

    def _open_serial(self):
        """Open the serial port. Fail gracefully so the node still starts."""
        try:
            self.ser = serial.Serial(
                port=SERIAL_PORT,
                baudrate=BAUD_RATE,
                timeout=0.01,
                write_timeout=0.5
            )
            self.get_logger().info(f'Serial opened: {SERIAL_PORT} @ {BAUD_RATE}')
        except serial.SerialException as e:
            self.get_logger().error(f'Could not open {SERIAL_PORT}: {e}')
            self.get_logger().info('Available ports:')
            for p in serial.tools.list_ports.comports():
                self.get_logger().info(f'  {p.device} — {p.description}')
            self.ser = None

    def _serial_timer_callback(self):
        """Called by the timer. Read available lines and publish."""
        if self.ser is None or not self.ser.is_open:
            return

        try:
            while self.ser.in_waiting > 0:
                raw = self.ser.readline()
                if not raw:
                    break
                line = raw.decode('utf-8', errors='ignore').strip()
                if not line:
                    continue
                self._handle_line(line)
        except serial.SerialException as e:
            self.get_logger().error(f'Serial read error: {e}')
            self.ser = None

    def _handle_line(self, line: str):
        """
        Parse the production format from DW_003 sketch:
            PIR:0 RCWL:1 FUSED:0
        """
        # Ignore startup banner / non-data lines
        if not line.startswith('PIR:'):
            self.get_logger().debug(f'MCU: {line}')
            return

        try:
            parts = line.split()
            # Expect exactly three tokens: PIR:x  RCWL:y  FUSED:z
            if len(parts) != 3:
                self.get_logger().warn(f'Unexpected token count: {line!r}')
                return

            pir_val   = int(parts[0].split(':', 1)[1])
            rcwl_val  = int(parts[1].split(':', 1)[1])
            fused_val = int(parts[2].split(':', 1)[1])

            # Publish each topic
            msg_pir = Bool()
            msg_pir.data = bool(pir_val)
            self.pub_pir.publish(msg_pir)

            msg_rcwl = Bool()
            msg_rcwl.data = bool(rcwl_val)
            self.pub_rcwl.publish(msg_rcwl)

            msg_fused = Bool()
            msg_fused.data = bool(fused_val)
            self.pub_fused.publish(msg_fused)

            self.get_logger().info(
                f'Published  pir={msg_pir.data}  rcwl={msg_rcwl.data}  fused={msg_fused.data}'
            )

        except (ValueError, IndexError) as e:
            self.get_logger().warn(f'Bad data line: {line!r}  ({e})')


def main(args=None):
    rclpy.init(args=args)
    node = DWSerialEntryNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node.ser is not None and node.ser.is_open:
            node.ser.close()
            node.get_logger().info('Serial closed')
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
