bool readTouch(int16_t &x, int16_t &y) {
  if (!ts.touched()) return false;
  TS_Point p = ts.getPoint();
  // Map into portrait space
  x = map(p.x, TOUCH_X_MIN, TOUCH_X_MAX, 0, SCR_W);
  y = map(p.y, TOUCH_Y_MIN, TOUCH_Y_MAX, 0, SCR_H);
  x = constrain(x, 0, SCR_W - 1);
  y = constrain(y, 0, SCR_H - 1);
  return true;
}

// -------------------- MQTT --------------------
void applyStatusJson(const char* json) {
  StaticJsonDocument<512> doc;
  DeserializationError err = deserializeJson(doc, json);
  if (err) return;

  char newAffect[16];
  const char* aff = doc["affect"] | "CALM";
  strncpy(newAffect, aff, sizeof(newAffect) - 1);
  newAffect[sizeof(newAffect) - 1] = '\0';

  uint8_t newLevel = (uint8_t)(doc["level"] | 0);
  uint8_t newVig   = (uint8_t)constrain((int)(doc["vigilance"] | 0), 0, 100);
  bool newPir      = doc["pir"]   | false;
  bool newRcwl     = doc["rcwl"]  | false;
  bool newFused    = doc["fused"] | false;
  bool newShock    = doc["shock"] | false;
  bool newTilt     = doc["tilt"]  | false;

  // Live debug-exit keys; fall back to legacy names
  float newTiltX = 0.0f;
  float newTiltY = 0.0f;
  if (doc.containsKey("orientation_x")) newTiltX = doc["orientation_x"].as<float>();
  else if (doc.containsKey("tilt_x"))   newTiltX = doc["tilt_x"].as<float>();
  if (doc.containsKey("orientation_y")) newTiltY = doc["orientation_y"].as<float>();
  else if (doc.containsKey("tilt_y"))   newTiltY = doc["tilt_y"].as<float>();

  // Distance → centimeters for bars
  // Heuristic: >50 treat as mm, <15 treat as meters, else cm
  auto rawToCm = [](float v) -> uint16_t {
    if (v <= 0.0f) return 0;
    if (v > 50.0f) return (uint16_t)constrain((int)(v / 10.0f + 0.5f), 0, 999);
    if (v < 15.0f) return (uint16_t)constrain((int)(v * 100.0f + 0.5f), 0, 999);
    return (uint16_t)constrain((int)(v + 0.5f), 0, 999);
  };

  float rawBeam = 0.0f;
  float rawCone = 0.0f;
  if (doc.containsKey("tof_distance"))           rawBeam = doc["tof_distance"].as<float>();
  else if (doc.containsKey("beam_cm"))           rawBeam = doc["beam_cm"].as<float>();
  if (doc.containsKey("ultrasonic_distance"))    rawCone = doc["ultrasonic_distance"].as<float>();
  else if (doc.containsKey("cone_cm"))           rawCone = doc["cone_cm"].as<float>();

  uint16_t newBeam = rawToCm(rawBeam);
  uint16_t newCone = rawToCm(rawCone);
  uint16_t newWall = (uint16_t)(doc["wall_cm"] | 0);

  char newExpr[24];
  const char* expr = doc["oled_expr"] | newAffect;
  strncpy(newExpr, expr, sizeof(newExpr) - 1);
  newExpr[sizeof(newExpr) - 1] = '\0';

  bool changed =
      (strcmp(newAffect, data.affectState) != 0) ||
      (newLevel != data.level) ||
      (newVig   != data.vigilancePct) ||
      (newPir   != data.pirActive) ||
      (newRcwl  != data.rcwlActive) ||
      (newFused != data.fusedMotion) ||
      (newShock != data.shockLatched) ||
      (newTilt  != data.tiltActive) ||
      (fabsf(newTiltX - data.tiltX) > 0.5f) ||
      (fabsf(newTiltY - data.tiltY) > 0.5f) ||
      (newBeam  != data.beamCm) ||
      (newCone  != data.coneCm) ||
      (strcmp(newExpr, data.oledExpr) != 0);

  strncpy(data.affectState, newAffect, sizeof(data.affectState) - 1);
  data.level         = newLevel;
  data.vigilancePct  = newVig;
  data.pirActive     = newPir;
  data.rcwlActive    = newRcwl;
  data.fusedMotion   = newFused;
  data.shockLatched  = newShock;
  data.tiltActive    = newTilt;
  data.tiltX         = newTiltX;
  data.tiltY         = newTiltY;
  data.beamCm        = newBeam;
  data.coneCm        = newCone;
  data.wallCm        = newWall;
  strncpy(data.oledExpr, newExpr, sizeof(data.oledExpr) - 1);

  data.lastPacketMs = millis();
  data.packetCount++;
  data.linkUp = true;

  if (newPir || newRcwl || newFused) data.sawMotion = true;
  if (newBeam > 0) data.sawTof = true;
  if (newCone > 0) data.sawUs = true;
  if (fabsf(newTiltX) > 0.2f || fabsf(newTiltY) > 0.2f || newTilt || newShock)
    data.sawOrient = true;
  if (newAffect[0]) data.sawAffect = true;

  if (changed) dataDirty = true;
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  char buf[512];
  if (length >= sizeof(buf)) length = sizeof(buf) - 1;
  memcpy(buf, payload, length);
  buf[length] = '\0';
  applyStatusJson(buf);
}

bool mqttReconnect() {
  if (mqtt.connected()) return true;
  Serial.print("MQTT connect...");
  if (mqtt.connect(MQTT_CLIENT_ID)) {
    Serial.println("ok");
    mqtt.subscribe(MQTT_TOPIC);
    return true;
  }
  Serial.print("fail rc=");
  Serial.println(mqtt.state());
  return false;
}

void ensureNetwork() {
  if (WiFi.status() != WL_CONNECTED) {
    if (data.linkUp) {
      data.linkUp = false;
      dataDirty = true;
    }
    static uint32_t lastAttempt = 0;
    if (millis() - lastAttempt < 5000) return;
    lastAttempt = millis();
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    return;
  }
  if (!mqtt.connected()) {
    static uint32_t lastMqttTry = 0;
    if (millis() - lastMqttTry < 3000) return;
    lastMqttTry = millis();
    mqttReconnect();
  }
}

// -------------------- Shared chrome --------------------
uint16_t affectColor(const char* state) {
  if (strcasecmp(state, "CALM")    == 0) return TFT_CYAN;
  if (strcasecmp(state, "ALERT")   == 0) return TFT_YELLOW;
  if (strcasecmp(state, "FOCUSED") == 0) return TFT_GREEN;
  if (strcasecmp(state, "WARY")    == 0) return TFT_ORANGE;
  if (strcasecmp(state, "GUARDED") == 0 || strcasecmp(state, "STOP") == 0) return TFT_RED;
  return TFT_WHITE;
}

