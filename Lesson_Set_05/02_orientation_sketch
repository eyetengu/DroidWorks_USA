  tft.setTextColor(data.shockLatched ? TFT_RED : TFT_DARKGREY, TFT_BLACK);
  tft.drawString(data.shockLatched ? "SHOCK" : "Shock quiet", 16, 150, 2);
}

void drawOrientationVolatile() { drawOrientation(); }

// -------------------- Radar (simple bars) --------------------
void drawRadar() {
  drawHeader("Radar");
  drawLinkChip();
  drawDistanceBar(70,  "ToF beam", data.beamCm, TFT_CYAN);
  drawDistanceBar(120, "US cone",  data.coneCm, TFT_GREENYELLOW);
  if (data.wallCm > 0) {
    char buf[24];
    snprintf(buf, sizeof(buf), "Wall %u cm", data.wallCm);
    tft.setTextDatum(TL_DATUM);
    tft.setTextColor(TFT_SILVER, TFT_BLACK);
    tft.drawString(buf, 12, 160, 2);
  }
}

void drawRadarVolatile() { drawRadar(); }

// -------------------- System --------------------
void drawSystem() {
  drawHeader("System");
  drawLinkChip();
  char buf[48];
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);

  snprintf(buf, sizeof(buf), "Packets  %lu", (unsigned long)data.packetCount);
  tft.drawString(buf, 16, 50, 2);

  uint32_t age = data.linkUp ? (millis() - data.lastPacketMs) : 0;
  snprintf(buf, sizeof(buf), "Age      %lu ms", (unsigned long)age);
  tft.drawString(buf, 16, 80, 2);

  snprintf(buf, sizeof(buf), "WiFi     %s",
           WiFi.status() == WL_CONNECTED ? "up" : "down");
  tft.drawString(buf, 16, 110, 2);

  if (WiFi.status() == WL_CONNECTED) {
    snprintf(buf, sizeof(buf), "IP %s", WiFi.localIP().toString().c_str());
    tft.drawString(buf, 16, 140, 2);
  }

  snprintf(buf, sizeof(buf), "Page %u / %u", currentPage + 1, PAGE_COUNT);
  tft.drawString(buf, 16, 180, 2);
}

void drawSystemVolatile() { drawSystem(); }

// -------------------- Dispatch --------------------
void drawCurrentPageFull() {
  tft.fillScreen(TFT_BLACK);
  switch (currentPage) {
    case PAGE_FACE:        drawFaceFull();        break;
    case PAGE_NODES:       drawNodes();           break;
    case PAGE_TOPICS:      drawTopics();          break;
    case PAGE_MOTION:      drawMotion();          break;
    case PAGE_ORIENTATION: drawOrientation();     break;
    case PAGE_RADAR:       drawRadar();           break;
    case PAGE_SYSTEM:      drawSystem();          break;
  }
  drawPageDots();
  fullDirty = false;
  dataDirty = false;
  lastFullRedrawMs = millis();
  lastVolatileRedrawMs = millis();
}

void drawCurrentPageVolatile() {
  switch (currentPage) {
    case PAGE_FACE:        drawFaceVolatile();        break;
    case PAGE_NODES:       drawNodesVolatile();       break;
    case PAGE_TOPICS:      drawTopicsVolatile();      break;
    case PAGE_MOTION:      drawMotionVolatile();      break;
    case PAGE_ORIENTATION: drawOrientationVolatile(); break;
    case PAGE_RADAR:       drawRadarVolatile();       break;
    case PAGE_SYSTEM:      drawSystemVolatile();      break;
  }
  dataDirty = false;
  lastVolatileRedrawMs = millis();
}

void nextPage() { currentPage = (currentPage + 1) % PAGE_COUNT; fullDirty = true; }
void prevPage() { currentPage = (currentPage == 0) ? PAGE_COUNT - 1 : currentPage - 1; fullDirty = true; }
void goHome()   { currentPage = PAGE_FACE; fullDirty = true; }

// -------------------- Setup / Loop --------------------
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\nDroidWorks CYD Face + Debug v0.4 (portrait)");

  tft.init();
  tft.setRotation(DISPLAY_ROTATION);
  tft.fillScreen(TFT_BLACK);

  touchSPI.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin(touchSPI);
  ts.setRotation(DISPLAY_ROTATION);

  // splash
  int logoX = (SCR_W - DW_LOGO_W) / 2;
  int logoY = (SCR_H - DW_LOGO_H) / 2 - 20;
  tft.pushImage(logoX, logoY, DW_LOGO_W, DW_LOGO_H, dw_logo);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_SILVER, TFT_BLACK);
  tft.drawString("Face v0.4", SCR_W / 2, logoY + DW_LOGO_H + 18, 2);
  tft.drawString("connecting...", SCR_W / 2, logoY + DW_LOGO_H + 38, 1);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  uint32_t wifiStart = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - wifiStart < 15000) {
    delay(400);
  }

  mqtt.setServer(MQTT_HOST, MQTT_PORT);
  mqtt.setCallback(mqttCallback);
  mqtt.setBufferSize(512);
  mqttReconnect();

  fullDirty = true;
}

void loop() {
  ensureNetwork();
  mqtt.loop();

  if (data.linkUp && (millis() - data.lastPacketMs > LINK_DEAD_MS)) {
    data.linkUp = false;
    dataDirty = true;
  }

  static bool wasStale = false;
  bool isStale = data.linkUp && (millis() - data.lastPacketMs > LINK_STALE_MS);
  if (isStale != wasStale) {
    wasStale = isStale;
    dataDirty = true;
  }

  if (millis() - lastFullRedrawMs >= FULL_REFRESH_MS) {
    fullDirty = true;
  }

  // touch nav
  int16_t tx, ty;
  bool down = readTouch(tx, ty);
  if (down && !touchWasDown) {
    touchDownMs = millis();
    touchStartX = tx;
    touchWasDown = true;
  } else if (!down && touchWasDown) {
    uint32_t held = millis() - touchDownMs;
    if (millis() - lastTouchNavMs > TOUCH_DEBOUNCE_MS) {
      if (held > 900) {
        goHome();
        lastTouchNavMs = millis();
      } else if (held < 500) {
        if (touchStartX < SCR_W / 3) {
          prevPage();
          lastTouchNavMs = millis();
        } else if (touchStartX > (2 * SCR_W) / 3) {
          nextPage();
          lastTouchNavMs = millis();
        }
      }
    }
    touchWasDown = false;
  }

  if (fullDirty) {
    drawCurrentPageFull();
  } else if (dataDirty && (millis() - lastVolatileRedrawMs >= VOLATILE_REFRESH_MS)) {
    drawCurrentPageVolatile();
  }

  delay(20);
}
