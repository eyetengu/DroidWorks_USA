void drawLinkChip() {
  tft.fillRect(SCR_W - 72, 24, 68, 12, TFT_BLACK);
  uint32_t age = millis() - data.lastPacketMs;
  tft.setTextDatum(TR_DATUM);
  if (!data.linkUp || age > LINK_DEAD_MS) {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.drawString("NO LINK", SCR_W - 6, 26, 1);
  } else if (age > LINK_STALE_MS) {
    tft.setTextColor(TFT_ORANGE, TFT_BLACK);
    tft.drawString("STALE", SCR_W - 6, 26, 1);
  } else {
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.drawString("LIVE", SCR_W - 6, 26, 1);
  }
}

