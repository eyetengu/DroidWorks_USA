void drawEye(int cx, int cy, int w, int h, bool open, uint16_t color) {
  if (open) {
    tft.fillRoundRect(cx - w / 2, cy - h / 2, w, h, h / 3, color);
  } else {
    // closed = thin lid line
    tft.fillRoundRect(cx - w / 2, cy - 3, w, 6, 3, TFT_DARKGREY);
  }
}

