/*
 * DW_005_Orientation_Shock_Tilt_Nano_millis_SERIAL.ino
 * DroidWorks U.S.A. — Lesson Set 04 (Orientation / Shock / Tilt)
 *
 * Single Arduino Nano + GY-521 (MPU-6050) + Tilt switch + Shock switch
 *
 * Added:
 *   - Reads DroidWorks identity from EEPROM
 *   - Broadcasts EID / TYPE / SENSOR / SENSOR2 at startup
 *
 * EEPROM layout:
 *   EID     = address 0
 *   TYPE    = address 32
 *   SENSOR  = address 64
 *   SENSOR2 = address 96
 *
 * Serial:
 *   115200 baud
 *
 * Runtime telemetry:
 *   TILT:0 SHOCK:0 AX:0.02 AY:-0.01 AZ:0.98
 */

#include <Wire.h>
#include <EEPROM.h>

// ---- EEPROM layout ----
const int EID_ADDR     = 0;
const int TYPE_ADDR    = 32;
const int SENSOR_ADDR  = 64;
const int SENSOR2_ADDR = 96;

// ---- Pins ----
const uint8_t PIN_SHOCK = 4;
const uint8_t PIN_TILT  = 5;

// ---- MPU-6050 ----
const uint8_t MPU_ADDR = 0x68;
const unsigned long IMU_INTERVAL_MS = 40;

// ---- Switch debounce ----
const unsigned long DEBOUNCE_MS = 25;

// ---- Serial ----
const unsigned long BAUD = 115200;
const unsigned long PRINT_INTERVAL_MS = 100;

// ---- State ----
bool lastTilt   = false;
bool lastShock  = false;
bool stableTilt = false;
bool stableShock = false;

unsigned long lastTiltChangeMs  = 0;
unsigned long lastShockChangeMs = 0;
unsigned long lastImuMs         = 0;
unsigned long lastPrintMs       = 0;

float ax = 0.0f;
float ay = 0.0f;
float az = 0.0f;


// --------------------------------------------------
// Read a null-terminated string from EEPROM
// --------------------------------------------------

void readEEPROMString(
  int address,
  char* buffer,
  int bufferSize
)
{
  int i = 0;

  for (; i < bufferSize - 1; i++)
  {
    char c = EEPROM.read(address + i);

    if (c == '\0')
    {
      break;
    }

    buffer[i] = c;
  }

  buffer[i] = '\0';
}


// --------------------------------------------------
// Broadcast DroidWorks identity
// --------------------------------------------------

void broadcastIdentity()
{
  char eid[32];
  char type[32];
  char sensor[32];
  char sensor2[32];

  readEEPROMString(EID_ADDR, eid, sizeof(eid));
  readEEPROMString(TYPE_ADDR, type, sizeof(type));
  readEEPROMString(SENSOR_ADDR, sensor, sizeof(sensor));
  readEEPROMString(SENSOR2_ADDR, sensor2, sizeof(sensor2));

  Serial.print(F("EID:"));
  Serial.print(eid);

  Serial.print(F(",TYPE:"));
  Serial.print(type);

  Serial.print(F(",SENSOR:"));
  Serial.print(sensor);

  Serial.print(F(",SENSOR2:"));
  Serial.println(sensor2);
}


// --------------------------------------------------
// MPU helpers
// --------------------------------------------------

void mpuWrite(uint8_t reg, uint8_t data)
{
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(data);
  Wire.endTransmission();
}


bool mpuReadAccel(float &x, float &y, float &z)
{
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);

  if (Wire.endTransmission(false) != 0)
    return false;

  if (Wire.requestFrom(MPU_ADDR, (uint8_t)6) != 6)
    return false;

  int16_t rawX = (Wire.read() << 8) | Wire.read();
  int16_t rawY = (Wire.read() << 8) | Wire.read();
  int16_t rawZ = (Wire.read() << 8) | Wire.read();

  const float scale = 16384.0f;

  x = rawX / scale;
  y = rawY / scale;
  z = rawZ / scale;

  return true;
}


// --------------------------------------------------
// Setup
// --------------------------------------------------

void setup()
{
  pinMode(PIN_SHOCK, INPUT_PULLUP);
  pinMode(PIN_TILT, INPUT_PULLUP);

  Wire.begin();
  Wire.setClock(400000);

  // Wake MPU-6050
  mpuWrite(0x6B, 0x00);
  delay(50);

  Serial.begin(BAUD);

  while (!Serial && millis() < 2000)
  {
    ;
  }

  delay(1000);

  // DroidWorks identity first.
  broadcastIdentity();

  Serial.println();
  Serial.println(
    F("DW_005 Orientation+Shock+Tilt Nano ready")
  );

  Serial.println(
    F("Format: TILT:x SHOCK:y AX:a AY:b AZ:c")
  );

  Serial.println(
    F("----------------------------------------")
  );
}


// --------------------------------------------------
// Main loop
// --------------------------------------------------

void loop()
{
  unsigned long now = millis();


  // ---- Read switches ----

  bool rawTilt =
    (digitalRead(PIN_TILT) == LOW);

  bool rawShock =
    (digitalRead(PIN_SHOCK) == LOW);


  // ---- Debounce tilt ----

  if (rawTilt != lastTilt)
  {
    lastTiltChangeMs = now;
    lastTilt = rawTilt;
  }

  if (
    (now - lastTiltChangeMs) >= DEBOUNCE_MS
  )
  {
    stableTilt = lastTilt;
  }


  // ---- Debounce shock ----

  if (rawShock != lastShock)
  {
    lastShockChangeMs = now;
    lastShock = rawShock;
  }

  if (
    (now - lastShockChangeMs) >= DEBOUNCE_MS
  )
  {
    stableShock = lastShock;
  }


  // ---- Read IMU ----

  if (
    now - lastImuMs >= IMU_INTERVAL_MS
  )
  {
    lastImuMs = now;

    if (!mpuReadAccel(ax, ay, az))
    {
      // Keep previous values.
    }
  }


  // ---- Print telemetry ----

  static bool lastPrintedTilt  = false;
  static bool lastPrintedShock = false;

  bool changed =
    (stableTilt != lastPrintedTilt) ||
    (stableShock != lastPrintedShock);

  if (
    changed ||
    (now - lastPrintMs >= PRINT_INTERVAL_MS)
  )
  {
    Serial.print(F("TILT:"));
    Serial.print(stableTilt ? 1 : 0);

    Serial.print(F(" SHOCK:"));
    Serial.print(stableShock ? 1 : 0);

    Serial.print(F(" AX:"));
    Serial.print(ax, 2);

    Serial.print(F(" AY:"));
    Serial.print(ay, 2);

    Serial.print(F(" AZ:"));
    Serial.println(az, 2);

    lastPrintedTilt  = stableTilt;
    lastPrintedShock = stableShock;
    lastPrintMs = now;
  }
}
