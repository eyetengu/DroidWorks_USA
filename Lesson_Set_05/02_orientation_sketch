void drawDistanceBar(int y, const char* label, uint16_t cm, uint16_t color) {
  const int x0 = 12;
  const int barW = SCR_W - 24;
  const int barH = 14;

  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_SILVER, TFT_BLACK);
  tft.drawString(label, x0, y - 14, 1);

  // track
  tft.drawRect(x0, y, barW, barH, TFT_DARKGREY);
  tft.fillRect(x0 + 1, y + 1, barW - 2, barH - 2, TFT_BLACK);

  if (cm > 0) {
    // Range bar: farther = fuller (reads as "how much room ahead")
    // Close object → short bar; clear path → long bar
    uint16_t clamped = cm > RADAR_MAX_CM ? RADAR_MAX_CM : cm;
    int fill = map(clamped, 0, RADAR_MAX_CM, 4, barW - 2);
    fill = constrain(fill, 4, barW - 2);
    tft.fillRect(x0 + 1, y + 1, fill, barH - 2, color);
  }

  char buf[24];
  if (cm == 0) snprintf(buf, sizeof(buf), "—");
  else         snprintf(buf, sizeof(buf), "%u cm", cm);
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString(buf, SCR_W - 12, y - 14, 1);
}

void drawFaceDistance() {
  tft.fillRect(0, 128, SCR_W, 88, TFT_BLACK);
  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_DARKGREY, TFT_BLACK);
  tft.drawString("DISTANCE", 12, 130, 1);

  drawDistanceBar(158, "ToF", data.beamCm, TFT_CYAN);
  drawDistanceBar(196, "US",  data.coneCm, TFT_GREENYELLOW);
}

void drawFaceOrientation() {
  tft.fillRect(0, 218, SCR_W, 88, TFT_BLACK);

  tft.setTextDatum(TL_DATUM);
  tft.setTextColor(TFT_DARKGREY, TFT_BLACK);
  tft.drawString("ORIENTATION", 12, 220, 1);

  // numeric roll / pitch
  char buf[32];
  snprintf(buf, sizeof(buf), "R %+5.1f", data.tiltX);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString(buf, 12, 238, 2);

  snprintf(buf, sizeof(buf), "P %+5.1f", data.tiltY);
  tft.drawString(buf, 12, 258, 2);

  // Face-local tilt: drive chip from the same R/P numbers on screen
  // so the chip always matches what you see (15° threshold).
  const float FACE_TILT_DEG = 15.0f;
  bool faceTilt =
      (fabsf(data.tiltX) > FACE_TILT_DEG) ||
      (fabsf(data.tiltY) > FACE_TILT_DEG);

  // status chips
  int chipY = 238;
  int chipX = 130;

  // tilt chip
  uint16_t tCol = faceTilt ? TFT_ORANGE : TFT_DARKGREY;
  tft.fillRoundRect(chipX, chipY, 96, 22, 4, tCol);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(faceTilt ? TFT_BLACK : TFT_SILVER, tCol);
  tft.drawString(faceTilt ? "TILT" : "level", chipX + 48, chipY + 11, 2);

  // shock chip — still from MQTT bool (needs a real impact > ~1.6g)
  chipY = 266;
  uint16_t sCol = data.shockLatched ? TFT_RED : TFT_DARKGREY;
  tft.fillRoundRect(chipX, chipY, 96, 22, 4, sCol);
  tft.setTextColor(data.shockLatched ? TFT_BLACK : TFT_SILVER, sCol);
  tft.drawString(data.shockLatched ? "SHOCK" : "stable", chipX + 48, chipY + 11, 2);
}

