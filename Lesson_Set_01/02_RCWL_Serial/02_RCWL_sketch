/*
  Lesson 2 – RCWL-0516 + Arduino Nano
  Serial output designed for a ROS2 node
  Format:
    rcwl:1   → Motion detected
    rcwl:0   → No motion
*/

#include <EEPROM.h>

// EEPROM addresses
const int EID_ADDR    = 0;
const int TYPE_ADDR   = 32;
const int SENSOR_ADDR = 64;

const int motionPin = 2;      // RCWL OUT → D2
const int ledPin = 13;        // Built-in LED

int currentState = 0;
int previousState = 0;

// Timing
unsigned long lastReadTime = 0;
const unsigned long READ_INTERVAL = 20;   // ms between reads

String readString(int address) {
  String result = "";
  for (int i = 0; i < 32; i++) {
    char character = EEPROM.read(address + i);
    if (character == '\0') {
      break;
    }
    result += character;
  }
  return result;
}

// Read and announce device identity from EEPROM
// Comment out the call to this function in setup() until you have written an ID
void announceDeviceFromEEPROM() {
  String eid    = readString(EID_ADDR);
  String type   = readString(TYPE_ADDR);
  String sensor = readString(SENSOR_ADDR);

  Serial.print("EID:");
  Serial.print(eid);
  Serial.print(",TYPE:");
  Serial.print(type);
  Serial.print(",SENSOR:");
  Serial.println(sensor);
}

void setup() {
  pinMode(motionPin, INPUT);
  pinMode(ledPin, OUTPUT);
  Serial.begin(115200);
  delay(2000);   // Only delay in setup (allowed)

  // Comment this line out until you have flashed an ID into EEPROM
  announceDeviceFromEEPROM();

  Serial.println("rcwl_ready");
  previousState = digitalRead(motionPin);
}

void loop() {
  unsigned long currentMillis = millis();

  // Non-blocking read interval
  if (currentMillis - lastReadTime >= READ_INTERVAL) {
    lastReadTime = currentMillis;

    currentState = digitalRead(motionPin);

    // Only publish when the state changes
    if (currentState != previousState) {
      if (currentState == HIGH) {
        digitalWrite(ledPin, HIGH);
        Serial.println("rcwl:1");      // Motion detected
      } else {
        digitalWrite(ledPin, LOW);
        Serial.println("rcwl:0");      // No motion
      }
      previousState = currentState;
    }
  }
}
