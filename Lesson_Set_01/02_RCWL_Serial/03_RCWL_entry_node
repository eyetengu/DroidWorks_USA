#!/usr/bin/env python3

import time

import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool

import serial
import serial.tools.list_ports


VID = 6790
PID = 29987
BAUD_RATE = 115200


class RcwlMotionNode(Node):

    def __init__(self):
        super().__init__('rcwl_motion_node')

        self.publisher_ = self.create_publisher(
            Bool,
            'rcwl_state',
            10
        )

        self.ser = None

        self._discover_rcwl()

        self.create_timer(
            0.05,
            self._serial_timer_callback
        )

    def _discover_rcwl(self):

        self.get_logger().info(
            'Searching for RCWL device...'
        )

        ports = serial.tools.list_ports.comports()

        for port in ports:

            if port.vid != VID or port.pid != PID:
                continue

            self.get_logger().info(
                f'Checking candidate: {port.device}'
            )

            try:

                ser = serial.Serial(
                    port.device,
                    BAUD_RATE,
                    timeout=0.5
                )

                start_time = time.time()

                while time.time() - start_time < 6:

                    raw = ser.readline()

                    if not raw:
                        continue

                    line = raw.decode(
                        'utf-8',
                        errors='ignore'
                    ).strip()

                    if line.startswith('EID:'):

                        self.get_logger().info(
                            f'Device announcement: {line}'
                        )

                        fields = line.split(',')

                        eid = ''
                        device_type = ''
                        sensor = ''

                        for field in fields:

                            if field.startswith('EID:'):
                                eid = field[4:]

                            elif field.startswith('TYPE:'):
                                device_type = field[5:]

                            elif field.startswith('SENSOR:'):
                                sensor = field[7:]

                        if (
                            device_type == 'MOTION'
                            and sensor == 'RCWL'
                        ):

                            self.ser = ser

                            self.get_logger().info(
                                f'RCWL FOUND | '
                                f'EID={eid} | '
                                f'PORT={port.device}'
                            )

                            return

                        break

                ser.close()

            except serial.SerialException as e:

                self.get_logger().warn(
                    f'Could not open {port.device}: {e}'
                )

        self.get_logger().error(
            'No RCWL device found.'
        )

    def _serial_timer_callback(self):

        if self.ser is None or not self.ser.is_open:
            return

        try:

            while self.ser.in_waiting > 0:

                raw = self.ser.readline()

                if not raw:
                    break

                line = raw.decode(
                    'utf-8',
                    errors='ignore'
                ).strip()

                if line:
                    self._handle_line(line)

        except serial.SerialException as e:

            self.get_logger().error(
                f'Serial read error: {e}'
            )

            self.ser = None

    def _handle_line(self, line):

        if line == 'rcwl:1':

            msg = Bool()
            msg.data = True

            self.publisher_.publish(msg)

            self.get_logger().info(
                'Motion detected → published True'
            )

        elif line == 'rcwl:0':

            msg = Bool()
            msg.data = False

            self.publisher_.publish(msg)

            self.get_logger().info(
                'No motion → published False'
            )

        else:

            self.get_logger().debug(
                f'MCU: {line}'
            )

    def destroy_node(self):

        if self.ser is not None and self.ser.is_open:
            self.ser.close()

        super().destroy_node()


def main(args=None):

    rclpy.init(args=args)

    node = RcwlMotionNode()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.get_logger().info(
            'Shutting down'
        )

        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
