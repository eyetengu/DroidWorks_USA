#!/usr/bin/env python3
"""
DroidWorks U.S.A. – ToF Sensor Module
Lesson Set 01 | 03_ToF_entryNode

Reads serial lines in the format:
    tof:423

and publishes the distance (in millimeters) as an Int32 on /tof_distance
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Int32
import serial
import re
import threading


class ToFEntry(Node):
    def __init__(self):
        super().__init__('tof_entry')

        # Publisher
        self.publisher_ = self.create_publisher(Int32, 'tof_distance', 10)

        # Serial port parameters (adjust if needed)
        self.port = '/dev/ttyUSB0'      # or /dev/ttyACM0
        self.baudrate = 115200
        self.timeout = 1.0

        self.ser = None
        self.running = True

        # Regex to extract the number after "tof:"
        self.pattern = re.compile(r'tof:([-+]?\d+)')

        # Start serial reading in a background thread
        self.serial_thread = threading.Thread(target=self.read_serial, daemon=True)
        self.serial_thread.start()

        self.get_logger().info('ToF entry node started. Listening for distance data...')

    def read_serial(self):
        try:
            self.ser = serial.Serial(self.port, self.baudrate, timeout=self.timeout)
            self.get_logger().info(f'Opened serial port: {self.port}')
        except serial.SerialException as e:
            self.get_logger().error(f'Failed to open serial port {self.port}: {e}')
            return

        while self.running and rclpy.ok():
            try:
                line = self.ser.readline().decode('utf-8', errors='ignore').strip()
                if not line:
                    continue

                match = self.pattern.search(line)
                if match:
                    distance = int(match.group(1))
                    msg = Int32()
                    msg.data = distance
                    self.publisher_.publish(msg)
                    # Optional debug:
                    # self.get_logger().info(f'Published: {distance} mm')
            except Exception as e:
                self.get_logger().warn(f'Serial read error: {e}')

    def destroy_node(self):
        self.running = False
        if self.ser and self.ser.is_open:
            self.ser.close()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = ToFEntry()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
