#!/usr/bin/env python3
"""
Droid Works USA – ToF Entry Node

Discovers the ToF device using EEPROM metadata
and publishes valid distance in millimeters
on /tof_distance.
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Int32

import serial
import serial.tools.list_ports
import re
import time


VID = 6790
PID = 29987
BAUD_RATE = 115200


class ToFEntry(Node):

    def __init__(self):
        super().__init__('tof_node')

        self.publisher_ = self.create_publisher(
            Int32,
            'tof_distance',
            10
        )

        self.ser = None

        self.pattern = re.compile(
            r'tof:([-+]?\d+)'
        )

        self.get_logger().info(
            'Searching for ToF device...'
        )

        self.discover_device()

        if self.ser is not None:
            self.timer = self.create_timer(
                0.01,
                self.read_serial
            )

    def discover_device(self):

        ports = serial.tools.list_ports.comports()

        for port in ports:

            if port.vid != VID or port.pid != PID:
                continue

            self.get_logger().info(
                f'Checking candidate: {port.device}'
            )

            try:
                ser = serial.Serial(
                    port.device,
                    BAUD_RATE,
                    timeout=0.5
                )

                start_time = time.time()

                while time.time() - start_time < 6:

                    raw = ser.readline()

                    if not raw:
                        continue

                    line = raw.decode(
                        'utf-8',
                        errors='ignore'
                    ).strip()

                    if not line:
                        continue

                    if line.startswith('EID:'):

                        self.get_logger().info(
                            f'Device announcement: {line}'
                        )

                        fields = line.split(',')

                        eid = ''
                        device_type = ''
                        sensor = ''

                        for field in fields:

                            if field.startswith('EID:'):
                                eid = field[4:].strip()

                            elif field.startswith('TYPE:'):
                                device_type = field[5:].strip()

                            elif field.startswith('SENSOR:'):
                                sensor = field[7:].strip()

                        if (
                            device_type == 'DISTANCE'
                            and sensor == 'TOF'
                        ):

                            self.ser = ser

                            self.get_logger().info(
                                f'TOF FOUND | '
                                f'EID={eid} | '
                                f'PORT={port.device}'
                            )

                            return

                        break

                ser.close()

            except Exception as e:

                self.get_logger().warn(
                    f'Could not check {port.device}: {e}'
                )

        self.get_logger().error(
            'No ToF device found.'
        )

    def read_serial(self):

        if self.ser is None:
            return

        try:

            raw = self.ser.readline()

            if not raw:
                return

            line = raw.decode(
                'utf-8',
                errors='ignore'
            ).strip()

            if not line:
                return

            match = self.pattern.search(line)

            if not match:
                return

            try:
                distance = int(match.group(1))
            except (ValueError, TypeError):
                return

            # Reject invalid ToF readings.
            # 8191 is a common VL53L0X error/out-of-range value.
            if distance <= 0 or distance >= 8190:
                return

            msg = Int32()
            msg.data = distance

            self.publisher_.publish(msg)

        except Exception as e:

            if rclpy.ok():
                self.get_logger().warn(
                    f'Serial read error: {e}'
                )

    def destroy_node(self):

        if self.ser is not None and self.ser.is_open:
            self.ser.close()

        super().destroy_node()


def main(args=None):

    rclpy.init(args=args)

    node = ToFEntry()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
