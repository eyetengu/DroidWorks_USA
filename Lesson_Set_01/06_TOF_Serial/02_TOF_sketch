/*
  DroidWorks U.S.A. – ToF Sensor Module
  Lesson Set 01 | 02_ToF_sketch
  VL53L0X wiring:
    VIN → 5V (or 3.3V depending on breakout)
    GND → GND
    SDA → A4
    SCL → A5
*/

#include <Wire.h>
#include <Adafruit_VL53L0X.h>
#include <EEPROM.h>

// EEPROM addresses
const int EID_ADDR    = 0;
const int TYPE_ADDR   = 32;
const int SENSOR_ADDR = 64;

Adafruit_VL53L0X lox = Adafruit_VL53L0X();

String readString(int address) {
  String result = "";
  for (int i = 0; i < 32; i++) {
    char character = EEPROM.read(address + i);
    if (character == '\0') {
      break;
    }
    result += character;
  }
  return result;
}

// Read and announce device identity from EEPROM
// Comment out the call to this function in setup() until you have written an ID
void announceDeviceFromEEPROM() {
  String eid    = readString(EID_ADDR);
  String type   = readString(TYPE_ADDR);
  String sensor = readString(SENSOR_ADDR);

  Serial.print("EID:");
  Serial.print(eid);
  Serial.print(",TYPE:");
  Serial.print(type);
  Serial.print(",SENSOR:");
  Serial.println(sensor);
}

void setup() {
  Serial.begin(115200);

  // Wait for serial to be ready
  while (!Serial) {
    delay(1);
  }
  delay(2000);

  // Comment this line out until you have flashed an ID into EEPROM
  announceDeviceFromEEPROM();

  // Initialize I2C and the sensor
  if (!lox.begin()) {
    Serial.println(F("tof:error - Failed to boot VL53L0X"));
    while (1);   // Halt if sensor not found
  } else {
    Serial.println("tof_ready");
  }

  // Optional: set continuous mode for faster updates
  lox.startRangeContinuous();
}

void loop() {
  VL53L0X_RangingMeasurementData_t measure;

  lox.rangingTest(&measure, false);  // false = no debug output

  if (measure.RangeStatus != 4) {    // 4 = out of range
    // Valid reading – print in the expected format
    Serial.print("tof:");
    Serial.println(measure.RangeMilliMeter);
  } else {
    // Out of range or invalid
    Serial.println("tof:0");
  }

  delay(50);   // ~20 Hz – good balance for ROS
}
