#!/usr/bin/env python3

"""
Droid Works USA – Ultrasonic Entry Node

Discovers the ultrasonic device using EEPROM metadata,
then converts cm → mm and publishes valid distance
on /ultrasonic_distance.
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Float32

import serial
import serial.tools.list_ports
import re
import time


VID = 6790
PID = 29987
BAUD_RATE = 115200


class UltrasonicEntry(Node):

    def __init__(self):
        super().__init__('ultrasonic_node')

        self.publisher_ = self.create_publisher(
            Float32,
            'ultrasonic_distance',
            10
        )

        self.ser = None

        # Pattern for: ultrasonic:118.5
        self.pattern = re.compile(
            r'ultrasonic:([-+]?\d*\.?\d+)'
        )

        self.get_logger().info(
            'Searching for Ultrasonic device...'
        )

        self.discover_device()

        if self.ser is not None:
            self.timer = self.create_timer(
                0.01,
                self.read_serial
            )

    def discover_device(self):

        ports = serial.tools.list_ports.comports()

        for port in ports:

            if port.vid != VID or port.pid != PID:
                continue

            self.get_logger().info(
                f'Checking candidate: {port.device}'
            )

            try:
                ser = serial.Serial(
                    port.device,
                    BAUD_RATE,
                    timeout=0.5
                )

                start_time = time.time()

                while time.time() - start_time < 6:

                    raw = ser.readline()

                    if not raw:
                        continue

                    line = raw.decode(
                        'utf-8',
                        errors='ignore'
                    ).strip()

                    if not line:
                        continue

                    if line.startswith('EID:'):

                        self.get_logger().info(
                            f'Device announcement: {line}'
                        )

                        fields = line.split(',')

                        eid = ''
                        device_type = ''
                        sensor = ''

                        for field in fields:

                            if field.startswith('EID:'):
                                eid = field[4:].strip()

                            elif field.startswith('TYPE:'):
                                device_type = field[5:].strip()

                            elif field.startswith('SENSOR:'):
                                sensor = field[7:].strip()

                        if (
                            device_type == 'DISTANCE'
                            and sensor == 'ULTRASONIC'
                        ):

                            self.ser = ser

                            self.get_logger().info(
                                f'ULTRASONIC FOUND | '
                                f'EID={eid} | '
                                f'PORT={port.device}'
                            )

                            return

                        break

                ser.close()

            except Exception as e:

                self.get_logger().warn(
                    f'Could not check {port.device}: {e}'
                )

        self.get_logger().error(
            'No Ultrasonic device found.'
        )

    def read_serial(self):

        if self.ser is None:
            return

        try:

            raw = self.ser.readline()

            if not raw:
                return

            line = raw.decode(
                'utf-8',
                errors='ignore'
            ).strip()

            if not line:
                return

            match = self.pattern.search(line)

            if not match:
                return

            value_str = match.group(1)

            try:
                distance_cm = float(value_str)
            except (ValueError, TypeError):
                return

            # Reject clearly invalid readings.
            if distance_cm <= 0.0 or distance_cm > 400.0:
                return

            # Convert centimeters to millimeters.
            distance_mm = distance_cm * 10.0

            msg = Float32()
            msg.data = distance_mm

            self.publisher_.publish(msg)

        except Exception as e:

            if rclpy.ok():
                self.get_logger().warn(
                    f'Serial read error: {e}'
                )

    def destroy_node(self):

        if self.ser is not None and self.ser.is_open:
            self.ser.close()

        super().destroy_node()


def main(args=None):

    rclpy.init(args=args)

    node = UltrasonicEntry()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
