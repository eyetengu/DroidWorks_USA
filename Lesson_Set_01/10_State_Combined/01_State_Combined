#!/usr/bin/env python3
"""
DroidWorks U.S.A. – Combined State Node
Lesson Set 01 – Final situational state

Subscribes to:
  /motion_state        (String)  – None / PIR_only / RCWL_only / Both
  /distance_matrix     (Int32)   – 0=Invalid, 1=Agree, 2=US_closer, 3=ToF_closer
  /proximity_id        (Int32)   – 0=Far, 1=Near, 2=TooClose
  /sensor_confidence   (String)  – High / Medium / Low

Publishes:
  /situational_state     (String)  – compact code  e.g. "3,2,2,High"
  /situational_summary   (String)  – human readable for debug OLED
  /expression_hint       (String)  – simple hint for face/expression OLED
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import String, Int32


class CombinedState(Node):
    def __init__(self):
        super().__init__('combined_state')

        # Latest values
        self.motion_str = "None"
        self.distance_matrix = 0
        self.proximity_id = 0
        self.confidence = "Low"

        # Publishers
        self.pub_state = self.create_publisher(String, 'situational_state', 10)
        self.pub_summary = self.create_publisher(String, 'situational_summary', 10)
        self.pub_expression = self.create_publisher(String, 'expression_hint', 10)

        # Subscribers
        self.create_subscription(String, 'motion_state', self.motion_callback, 10)
        self.create_subscription(Int32, 'distance_matrix', self.matrix_callback, 10)
        self.create_subscription(Int32, 'proximity_id', self.proximity_callback, 10)
        self.create_subscription(String, 'sensor_confidence', self.confidence_callback, 10)

        # Publish at a steady rate
        self.create_timer(0.1, self.publish_state)  # 10 Hz

        self.get_logger().info('Combined State node started')

    def motion_callback(self, msg: String):
        self.motion_str = msg.data

    def matrix_callback(self, msg: Int32):
        self.distance_matrix = msg.data

    def proximity_callback(self, msg: Int32):
        self.proximity_id = msg.data

    def confidence_callback(self, msg: String):
        self.confidence = msg.data

    def motion_to_id(self, motion_str: str) -> int:
        mapping = {
            "None": 0,
            "RCWL_only": 1,
            "PIR_only": 2,
            "Both": 3
        }
        return mapping.get(motion_str, 0)

    def matrix_to_str(self, mid: int) -> str:
        return {
            0: "Invalid",
            1: "Agree",
            2: "US_closer",
            3: "ToF_closer"
        }.get(mid, "Invalid")

    def proximity_to_str(self, pid: int) -> str:
        return {
            0: "Far",
            1: "Near",
            2: "TooClose"
        }.get(pid, "Far")

    def publish_state(self):
        motion_id = self.motion_to_id(self.motion_str)

        # Compact coded state
        code = f"{motion_id},{self.distance_matrix},{self.proximity_id},{self.confidence}"

        # Human-readable summary (for debug OLED)
        summary = (f"Motion:{self.motion_str} | "
                   f"Dist:{self.matrix_to_str(self.distance_matrix)} | "
                   f"Prox:{self.proximity_to_str(self.proximity_id)} | "
                   f"Conf:{self.confidence}")

        # Expression hint for the face OLED
        expression = self.decide_expression(motion_id, self.distance_matrix,
                                            self.proximity_id, self.confidence)

        # Publish
        msg = String()
        msg.data = code
        self.pub_state.publish(msg)

        msg = String()
        msg.data = summary
        self.pub_summary.publish(msg)

        msg = String()
        msg.data = expression
        self.pub_expression.publish(msg)

    def decide_expression(self, motion_id, matrix_id, proximity_id, confidence):
        """
        Simple mapping from situational state → expression hint.
        You can expand this later for richer faces.
        """
        if confidence == "Low":
            return "Confused"

        if proximity_id == 2:  # TooClose
            if motion_id >= 2:
                return "Alert"
            else:
                return "Uneasy"

        if proximity_id == 1:  # Near
            if motion_id == 3:
                return "Curious"
            elif motion_id > 0:
                return "Attentive"
            else:
                return "Neutral"

        # Far
        if motion_id > 0:
            return "Aware"
        else:
            return "Calm"


def main(args=None):
    rclpy.init(args=args)
    node = CombinedState()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
