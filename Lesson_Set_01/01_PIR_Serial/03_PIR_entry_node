#!/usr/bin/env python3

import time

import rclpy
from rclpy.node import Node

from std_msgs.msg import Bool

import serial
import serial.tools.list_ports


VID = 6790
PID = 29987
BAUD_RATE = 115200


class PIRNode(Node):

    def __init__(self):
        super().__init__('pir_node')

        self.get_logger().info(
            'Droid Works USA PIR node started'
        )

        self.publisher_ = self.create_publisher(
            Bool,
            '/pir_state',
            10
        )

        self.ser = None

        self._discover_pir()

        self.create_timer(
            0.05,
            self._serial_timer_callback
        )

    def _discover_pir(self):

        self.get_logger().info(
            'Searching for PIR device...'
        )

        ports = serial.tools.list_ports.comports()

        for port in ports:

            if port.vid != VID or port.pid != PID:
                continue

            self.get_logger().info(
                f'Checking candidate: {port.device}'
            )

            try:

                ser = serial.Serial(
                    port.device,
                    BAUD_RATE,
                    timeout=0.5
                )

                start_time = time.time()

                while time.time() - start_time < 3:

                    raw = ser.readline()

                    if not raw:
                        continue

                    line = raw.decode(
                        'utf-8',
                        errors='ignore'
                    ).strip()

                    if line.startswith('EID:'):

                        self.get_logger().info(
                            f'Device announcement: {line}'
                        )

                        fields = line.split(',')

                        device_type = ''
                        sensor = ''
                        eid = ''

                        for field in fields:

                            if field.startswith('EID:'):
                                eid = field[4:]

                            elif field.startswith('TYPE:'):
                                device_type = field[5:]

                            elif field.startswith('SENSOR:'):
                                sensor = field[7:]

                        if (
                            device_type == 'MOTION'
                            and sensor == 'PIR'
                        ):

                            self.ser = ser

                            self.get_logger().info(
                                f'PIR FOUND | '
                                f'EID={eid} | '
                                f'PORT={port.device}'
                            )

                            return

                        break

                ser.close()

            except serial.SerialException as e:

                self.get_logger().warn(
                    f'Could not open {port.device}: {e}'
                )

        self.get_logger().error(
            'No PIR device found.'
        )

    def _serial_timer_callback(self):

        if self.ser is None or not self.ser.is_open:
            return

        try:

            while self.ser.in_waiting > 0:

                raw = self.ser.readline()

                if not raw:
                    break

                line = raw.decode(
                    'utf-8',
                    errors='ignore'
                ).strip()

                if line:
                    self._handle_line(line)

        except serial.SerialException as e:

            self.get_logger().error(
                f'Serial read error: {e}'
            )

            self.ser = None

    def _handle_line(self, line):

        if line.startswith('pir:'):

            try:

                value = int(
                    line.split(':', 1)[1]
                )

                msg = Bool()
                msg.data = bool(value)

                self.publisher_.publish(msg)

                self.get_logger().info(
                    f'Published /pir_state = {msg.data}'
                )

            except (ValueError, IndexError):

                self.get_logger().warn(
                    f'Bad PIR line: {line!r}'
                )

        else:

            self.get_logger().debug(
                f'MCU: {line}'
            )


def main(args=None):

    rclpy.init(args=args)

    node = PIRNode()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:

        node.get_logger().info(
            'Shutting down'
        )

        if node.ser is not None and node.ser.is_open:
            node.ser.close()

        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()

