#include <EEPROM.h>

// PIR
const int pirPin = 2;
const int ledPin = 13;
int lastState = LOW;

// EEPROM addresses
const int EID_ADDR    = 0;
const int TYPE_ADDR   = 32;
const int SENSOR_ADDR = 64;

String readString(int address) {
  String result = "";
  for (int i = 0; i < 32; i++) {
    char character = EEPROM.read(address + i);
    if (character == '\0') {
      break;
    }
    result += character;
  }
  return result;
}

// Read and announce device identity from EEPROM
// Comment out the call to this function in setup() until you have written an ID
void announceDeviceFromEEPROM() {
  String eid    = readString(EID_ADDR);
  String type   = readString(TYPE_ADDR);
  String sensor = readString(SENSOR_ADDR);

  Serial.print("EID:");
  Serial.print(eid);
  Serial.print(",TYPE:");
  Serial.print(type);
  Serial.print(",SENSOR:");
  Serial.println(sensor);
}

void setup() {
  pinMode(pirPin, INPUT);
  pinMode(ledPin, OUTPUT);
  Serial.begin(115200);
  digitalWrite(ledPin, LOW);
  delay(2000);

  // Comment this line out until you have flashed an ID into EEPROM
  //announceDeviceFromEEPROM();

  // Establish initial PIR state after sensor settles
  lastState = digitalRead(pirPin);
  Serial.print("pir:");
  Serial.println(lastState);
}

void loop() {
  int currentState = digitalRead(pirPin);

  if (currentState != lastState) {
    digitalWrite(ledPin, currentState);
    Serial.print("pir:");
    Serial.println(currentState);
    lastState = currentState;
  }

  delay(50);
}
