        Node(
            package='droidworks_sensors',
            executable='pir_node',
            name='pir_node',
            output='screen',
        ),
        Node(
            package='droidworks_sensors',
            executable='rcwl_node',
            name='rcwl_node',
            output='screen',
        ),
        Node(
            package='droidworks_sensors',
            executable='fusion_motion',
            name='fusion_motion',
            output='screen',
        ),        
        Node(
            package='droidworks_sensors',
            executable='state_motion',
            name='state_motion',
            output='screen'
        ),
    ])
