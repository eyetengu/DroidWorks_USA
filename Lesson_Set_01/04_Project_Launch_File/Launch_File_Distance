        Node(
            package='droidworks_sensors',
            executable='ultrasonic_node',
            name='ultrasonic_node',
            output='screen',
        ),
        Node(
            package='droidworks_sensors',
            executable='tof_node',
            name='tof_node',
            output='screen',
        ),
        Node(
            package='droidworks_sensors',
            executable='fusion_distance',
            name='fusion_distance',
            output='screen'
        ),
        Node(
            package='droidworks_sensors',
            executable='state_distance',
            name='state_distance',
            output='screen'
        ),
    ])
