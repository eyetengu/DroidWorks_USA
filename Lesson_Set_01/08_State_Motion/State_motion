#!/usr/bin/env python3
"""
DroidWorks U.S.A. – Sensor Fusion Motion Module
Lesson Set 01 | 06_SensorFusion_Motion

Subscribes to:
  /pir_state   (Bool)
  /rcwl_state  (Bool)

Publishes:
  /motion_state      (String: None / PIR_only / RCWL_only / Both)
  /motion_confidence (String: High / Medium / Low)
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool, String


class SensorFusionMotion(Node):
    def __init__(self):
        super().__init__('sensorfusion_motion')

        # Latest sensor states
        self.pir = False
        self.rcwl = False

        # Publishers
        self.pub_state = self.create_publisher(String, 'motion_state', 10)
        self.pub_confidence = self.create_publisher(String, 'motion_confidence', 10)

        # Subscribers
        self.create_subscription(Bool, 'pir_state', self.pir_callback, 10)
        self.create_subscription(Bool, 'rcwl_state', self.rcwl_callback, 10)

        # Timer so we publish at a steady rate even if sensors are quiet
        self.create_timer(0.1, self.fuse)  # 10 Hz

        self.get_logger().info('Sensor Fusion Motion node started')

    def pir_callback(self, msg: Bool):
        self.pir = msg.data

    def rcwl_callback(self, msg: Bool):
        self.rcwl = msg.data

    def fuse(self):
        # Determine the 4-state matrix
        if not self.pir and not self.rcwl:
            state = "None"
            confidence = "Low"
        elif not self.pir and self.rcwl:
            state = "RCWL_only"
            confidence = "Medium"
        elif self.pir and not self.rcwl:
            state = "PIR_only"
            confidence = "Medium"
        else:
            state = "Both"
            confidence = "High"

        # Publish
        state_msg = String()
        state_msg.data = state
        self.pub_state.publish(state_msg)

        conf_msg = String()
        conf_msg.data = confidence
        self.pub_confidence.publish(conf_msg)


def main(args=None):
    rclpy.init(args=args)
    node = SensorFusionMotion()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
