#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define OLED_ADDR 0x3C

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  OLED_RESET
);

enum Expression
{
  CALM,
  ALERT,
  FOCUSED
};

Expression currentExpression = CALM;

char commandBuffer[20];
byte commandIndex = 0;

// --------------------------------------------------
// Draw the current expression
// --------------------------------------------------

void drawEyes()
{
  display.clearDisplay();

  if (currentExpression == CALM)
  {
    // CALM - medium rounded eyes
    display.fillRoundRect(
      20, 18, 35, 28, 6, SSD1306_WHITE
    );

    display.fillRoundRect(
      73, 18, 35, 28, 6, SSD1306_WHITE
    );
  }

  else if (currentExpression == ALERT)
  {
    // ALERT - tall/open eyes
    display.fillRoundRect(
      20, 14, 35, 36, 6, SSD1306_WHITE
    );

    display.fillRoundRect(
      73, 14, 35, 36, 6, SSD1306_WHITE
    );
  }

  else if (currentExpression == FOCUSED)
  {
    // FOCUSED - short/narrow eyes
    display.fillRoundRect(
      20, 23, 35, 18, 5, SSD1306_WHITE
    );

    display.fillRoundRect(
      73, 23, 35, 18, 5, SSD1306_WHITE
    );
  }

  display.display();
}

// --------------------------------------------------
// Process a command
// --------------------------------------------------

void processCommand()
{
  commandBuffer[commandIndex] = '\0';

  if (strcmp(commandBuffer, "CALM") == 0)
  {
    currentExpression = CALM;
    Serial.println("Expression: CALM");
  }

  else if (strcmp(commandBuffer, "ALERT") == 0)
  {
    currentExpression = ALERT;
    Serial.println("Expression: ALERT");
  }

  else if (strcmp(commandBuffer, "FOCUSED") == 0)
  {
    currentExpression = FOCUSED;
    Serial.println("Expression: FOCUSED");
  }

  else if (strcmp(commandBuffer, "HELP") == 0)
  {
    Serial.println("Commands:");
    Serial.println("CALM");
    Serial.println("ALERT");
    Serial.println("FOCUSED");
  }

  else if (commandIndex > 0)
  {
    Serial.println("Unknown command. Type HELP.");
  }

  drawEyes();

  commandIndex = 0;
}

// --------------------------------------------------
// Setup
// --------------------------------------------------

void setup()
{
  Serial.begin(115200);
  delay(500);

  Wire.begin();

  Serial.println("Starting OLED...");

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR))
  {
    Serial.println("SSD1306 initialization FAILED.");

    while (true)
    {
      delay(1000);
    }
  }

  Serial.println("SSD1306 initialization OK.");

  display.setRotation(2);

  drawEyes();

  Serial.println("OLED ready.");
  Serial.println("Type CALM, ALERT, FOCUSED, or HELP.");
}

// --------------------------------------------------
// Loop
// --------------------------------------------------

void loop()
{
  while (Serial.available())
  {
    char c = Serial.read();

    // Enter / Return
    if (c == '\n' || c == '\r')
    {
      if (commandIndex > 0)
      {
        processCommand();
      }
    }

    // Add character to command buffer
    else if (commandIndex < sizeof(commandBuffer) - 1)
    {
      // Convert lowercase to uppercase
      if (c >= 'a' && c <= 'z')
      {
        c = c - 'a' + 'A';
      }

      commandBuffer[commandIndex++] = c;
    }
  }
}
