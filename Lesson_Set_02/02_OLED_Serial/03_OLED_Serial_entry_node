#!/usr/bin/env python3
"""
DroidWorks U.S.A. – OLED Serial Bridge
Lesson Set 02

Subscribes to Combined State topics and sends them over serial
to an Arduino Nano + OLED display.
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import String
import serial
import threading
import time


class OledSerial(Node):
    def __init__(self):
        super().__init__('oled_serial')

        # ---------- Serial settings ----------
        self.declare_parameter('port', '/dev/ttyUSB4')      # change to your Nano port
        self.declare_parameter('baudrate', 115200)
        self.declare_parameter('send_rate_hz', 5.0)          # how often to push data

        self.port = self.get_parameter('port').value
        self.baudrate = self.get_parameter('baudrate').value
        self.send_rate = self.get_parameter('send_rate_hz').value

        self.ser = None
        self.running = True

        # Latest values from Combined State
        self.current_summary = "Waiting for data..."
        self.current_expression = "None"

        # ---------- ROS subscriptions ----------
        self.create_subscription(String, 'situational_summary', self.summary_callback, 10)
        self.create_subscription(String, 'expression_hint', self.expression_callback, 10)

        # Open serial
        self.open_serial()

        # Timer to push data at a steady rate
        period = 1.0 / self.send_rate
        self.create_timer(period, self.send_to_display)

        self.get_logger().info('OLED Serial bridge started')
        self.get_logger().info(f'Sending to {self.port} @ {self.baudrate} baud')

    def open_serial(self):
        try:
            self.ser = serial.Serial(self.port, self.baudrate, timeout=1.0)
            time.sleep(2.0)   # give the Nano time to reset after serial open
            self.get_logger().info(f'Opened serial port: {self.port}')
        except serial.SerialException as e:
            self.get_logger().error(f'Failed to open serial port {self.port}: {e}')
            self.ser = None

    def summary_callback(self, msg: String):
        self.current_summary = msg.data

    def expression_callback(self, msg: String):
        self.current_expression = msg.data

    def send_to_display(self):
        if self.ser is None or not self.ser.is_open:
            return

        try:
            # Simple text protocol (same style as MQTT version)
            line1 = f"SUMMARY:{self.current_summary}\n"
            line2 = f"EXPR:{self.current_expression}\n"

            self.ser.write(line1.encode('utf-8'))
            self.ser.write(line2.encode('utf-8'))
            self.ser.flush()

        except Exception as e:
            self.get_logger().warn(f'Serial write error: {e}')
            # Attempt to reopen on error
            try:
                if self.ser:
                    self.ser.close()
            except:
                pass
            self.open_serial()

    def destroy_node(self):
        self.running = False
        if self.ser and self.ser.is_open:
            self.ser.close()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = OledSerial()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
